#!/usr/bin/env bash
set -euo pipefail

NIDAVELIR_HOME="${NIDAVELIR_HOME:-/opt/nidavelir}"
COMPOSE_FILE="$NIDAVELIR_HOME/compose.yaml"
ENV_FILE="$NIDAVELIR_HOME/.env"
RAW_BASE="https://raw.githubusercontent.com/Nicolas25vlad/nidavelir/main"

fatal() {
  printf 'nidavelir: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fatal "$1 is required"
}

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

require_install() {
  [[ -r "$COMPOSE_FILE" ]] || fatal "installation not readable at $COMPOSE_FILE"
  [[ -r "$ENV_FILE" ]] || fatal "configuration not readable at $ENV_FILE"
}

require_write_access() {
  [[ -w "$COMPOSE_FILE" ]] || fatal "$COMPOSE_FILE is not writable; check membership in the nidavelir operator group"
  [[ -w "$ENV_FILE" ]] || fatal "$ENV_FILE is not writable; check membership in the nidavelir operator group"
}

require_docker_access() {
  need docker
  docker compose version >/dev/null 2>&1 || fatal "Docker Compose v2 is required"
  if ! docker info >/dev/null 2>&1; then
    fatal "cannot access the Docker daemon as $(id -un); use rootless Docker or grant this operator Docker access"
  fi
}

env_value() {
  local key="$1"
  awk -F= -v key="$key" '$1 == key {print substr($0, index($0, "=") + 1)}' "$ENV_FILE" | tail -n1
}

current_version() {
  env_value NIDAVELIR_VERSION
}

set_version() {
  local version="$1"
  if grep -q '^NIDAVELIR_VERSION=' "$ENV_FILE"; then
    local tmp
    tmp="$(mktemp)"
    awk -v version="$version" '
      BEGIN { updated = 0 }
      /^NIDAVELIR_VERSION=/ && !updated { print "NIDAVELIR_VERSION=" version; updated = 1; next }
      { print }
    ' "$ENV_FILE" > "$tmp"
    cat "$tmp" > "$ENV_FILE"
    rm -f "$tmp"
  else
    printf '\nNIDAVELIR_VERSION=%s\n' "$version" >> "$ENV_FILE"
  fi
}

worker_image() {
  local version
  version="$(current_version)"
  [[ -n "$version" ]] || version="latest"
  printf 'ghcr.io/nicolas25vlad/nidavelir-worker:%s\n' "$version"
}

auth_volume() {
  case "$1" in
    codex) printf 'nidavelir-codex-auth\n' ;;
    cursor) printf 'nidavelir-cursor-auth\n' ;;
    *) fatal "unsupported harness '$1' (expected codex or cursor)" ;;
  esac
}

auth_mount() {
  case "$1" in
    codex) printf '/home/nidavelir/.codex\n' ;;
    cursor) printf '/home/nidavelir/.cursor\n' ;;
    *) fatal "unsupported harness '$1' (expected codex or cursor)" ;;
  esac
}

ensure_auth_volume() {
  local harness="$1"
  local volume
  volume="$(auth_volume "$harness")"
  docker volume inspect "$volume" >/dev/null 2>&1 || docker volume create "$volume" >/dev/null
}

run_harness_auth() {
  local harness="$1"
  shift
  local image volume mount
  image="$(worker_image)"
  volume="$(auth_volume "$harness")"
  mount="$(auth_mount "$harness")"

  docker image inspect "$image" >/dev/null 2>&1 || docker pull "$image" >/dev/null

  local tty=()
  if [[ -t 0 && -t 1 ]]; then
    tty=(-it)
  else
    tty=(-i)
  fi

  docker run --rm "${tty[@]}" \
    --user 10001:10001 \
    --entrypoint /bin/bash \
    -e HOME=/home/nidavelir \
    -e CURSOR_CONFIG_DIR=/home/nidavelir/.cursor \
    -v "$volume:$mount" \
    "$image" -lc "$*"
}

cmd_auth_login() {
  require_install
  require_docker_access
  local harness="${1:-}"
  [[ -n "$harness" ]] || fatal "usage: nidavelir auth login <codex|cursor>"
  ensure_auth_volume "$harness"

  case "$harness" in
    codex)
      printf 'Starting Codex account login. Complete the browser flow shown by Codex.\n'
      run_harness_auth codex 'codex login'
      ;;
    cursor)
      printf 'Starting Cursor account login. Open the URL printed by Cursor in a browser.\n'
      run_harness_auth cursor 'NO_OPEN_BROWSER=1 agent login'
      ;;
    *) fatal "unsupported harness '$harness' (expected codex or cursor)" ;;
  esac
}

cmd_auth_status_one() {
  local harness="$1"
  local volume
  volume="$(auth_volume "$harness")"
  if ! docker volume inspect "$volume" >/dev/null 2>&1; then
    printf '%s: no persistent login\n' "$harness"
    return 1
  fi

  case "$harness" in
    codex)
      if run_harness_auth codex 'codex login status'; then
        printf 'codex: persistent login ready\n'
        return 0
      fi
      ;;
    cursor)
      if run_harness_auth cursor 'agent status'; then
        printf 'cursor: persistent login ready\n'
        return 0
      fi
      ;;
  esac
  printf '%s: persistent login is not valid\n' "$harness"
  return 1
}

cmd_auth_status() {
  require_install
  require_docker_access
  local harness="${1:-}"
  if [[ -n "$harness" ]]; then
    cmd_auth_status_one "$harness"
    return
  fi

  local failed=0
  cmd_auth_status_one codex || failed=1
  cmd_auth_status_one cursor || failed=1
  return "$failed"
}

cmd_auth_logout() {
  require_install
  require_docker_access
  local harness="${1:-}"
  [[ -n "$harness" ]] || fatal "usage: nidavelir auth logout <codex|cursor>"
  local volume
  volume="$(auth_volume "$harness")"

  if docker volume inspect "$volume" >/dev/null 2>&1; then
    case "$harness" in
      codex) run_harness_auth codex 'codex logout' || true ;;
      cursor) run_harness_auth cursor 'agent logout' || true ;;
      *) fatal "unsupported harness '$harness' (expected codex or cursor)" ;;
    esac
    docker volume rm "$volume" >/dev/null || fatal "auth volume is in use; stop active $harness workers first"
  fi
  printf '%s: persistent login removed\n' "$harness"
}

cmd_auth() {
  local action="${1:-}"
  shift || true
  case "$action" in
    login) cmd_auth_login "$@" ;;
    status) cmd_auth_status "$@" ;;
    logout) cmd_auth_logout "$@" ;;
    *) fatal "usage: nidavelir auth <login|status|logout> [codex|cursor]" ;;
  esac
}

cmd_update() {
  require_install
  require_write_access
  require_docker_access
  need curl

  local requested="${1:-latest}"
  local previous
  previous="$(current_version)"
  [[ -n "$previous" ]] || previous="latest"

  printf 'Updating Nidavelir: %s -> %s\n' "$previous" "$requested"

  local tmp
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN
  curl -fsSL "$RAW_BASE/deploy/compose.prod.yaml" -o "$tmp"
  docker compose --env-file "$ENV_FILE" -f "$tmp" config --quiet
  cat "$tmp" > "$COMPOSE_FILE"
  set_version "$requested"

  if ! compose pull; then
    set_version "$previous"
    fatal "image pull failed; version restored to $previous"
  fi

  if ! compose up -d --remove-orphans; then
    printf 'Update failed, attempting rollback to %s\n' "$previous" >&2
    set_version "$previous"
    compose pull || true
    compose up -d --remove-orphans || true
    fatal "update failed and rollback was attempted"
  fi

  compose ps
  printf 'Nidavelir is running version %s\n' "$requested"
}

cmd_status() {
  require_install
  require_docker_access
  compose ps
}

cmd_logs() {
  require_install
  require_docker_access
  local service="${1:-}"
  if [[ -n "$service" ]]; then
    compose logs --tail=200 -f "$service"
  else
    compose logs --tail=200 -f
  fi
}

cmd_restart() {
  require_install
  require_docker_access
  compose restart "$@"
  compose ps
}

cmd_stop() {
  require_install
  require_docker_access
  compose stop
}

cmd_start() {
  require_install
  require_docker_access
  compose up -d
  compose ps
}

cmd_doctor() {
  require_install

  local failed=0
  printf 'Install dir: %s\n' "$NIDAVELIR_HOME"
  printf 'Version: %s\n' "$(current_version)"
  printf 'Operator: %s\n' "$(id -un)"

  if [[ -w "$ENV_FILE" && -w "$COMPOSE_FILE" ]]; then
    printf 'Permissions: operator files writable\n'
  else
    printf 'FAILED: operator cannot write Nidavelir config/update files\n'
    failed=1
  fi

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
      printf 'Docker: accessible without sudo\n'
    else
      printf 'FAILED: Docker daemon is not accessible as %s\n' "$(id -un)"
      failed=1
    fi
  else
    printf 'FAILED: Docker Engine and Compose v2 are required\n'
    failed=1
  fi

  for key in NIDAVELIR_DATABASE_URL NIDAVELIR_POSTGRES_PASSWORD; do
    if ! grep -q "^${key}=." "$ENV_FILE"; then
      printf 'MISSING: %s\n' "$key"
      failed=1
    fi
  done

  if ! grep -q '^NIDAVELIR_GITHUB_TOKEN=.' "$ENV_FILE"; then
    printf 'MISSING: NIDAVELIR_GITHUB_TOKEN (task branches cannot be pushed)\n'
    failed=1
  fi

  local harness_ready=0
  if grep -q '^NIDAVELIR_OPENAI_API_KEY=.' "$ENV_FILE"; then
    printf 'Harness: Codex API-key auth configured\n'
    harness_ready=1
  elif docker info >/dev/null 2>&1 && cmd_auth_status_one codex >/dev/null 2>&1; then
    printf 'Harness: Codex persistent login ready\n'
    harness_ready=1
  else
    printf 'Harness: Codex not authenticated\n'
  fi

  if grep -q '^NIDAVELIR_CURSOR_API_KEY=.' "$ENV_FILE"; then
    printf 'Harness: Cursor API-key auth configured\n'
    harness_ready=1
  elif docker info >/dev/null 2>&1 && cmd_auth_status_one cursor >/dev/null 2>&1; then
    printf 'Harness: Cursor persistent login ready\n'
    harness_ready=1
  else
    printf 'Harness: Cursor not authenticated\n'
  fi

  if [[ "$harness_ready" -eq 0 ]]; then
    printf 'MISSING: authenticate at least one harness with `nidavelir auth login` or an API key\n'
    failed=1
  fi

  if ! compose config --quiet; then
    printf 'FAILED: compose config\n'
    failed=1
  fi

  if docker info >/dev/null 2>&1 && compose ps >/dev/null 2>&1; then
    compose ps
  else
    printf 'WARN: stack status unavailable\n'
  fi

  if [[ "$failed" -eq 0 ]]; then
    printf 'Doctor: OK\n'
  else
    printf 'Doctor: configuration needs attention\n'
    exit 1
  fi
}

cmd_version() {
  require_install
  current_version
}

usage() {
  cat <<'EOF'
Usage: nidavelir <command> [args]

Commands:
  update [version]             Pull and deploy latest or a pinned image tag
  status                       Show service state
  logs [service]               Follow logs, optionally for one service
  restart [service]            Restart the whole stack or selected service(s)
  start                        Start the stack
  stop                         Stop services without deleting data
  auth login <harness>         Authenticate Codex or Cursor with its normal login flow
  auth status [harness]        Check persistent harness login state
  auth logout <harness>        Remove persistent harness login state
  doctor                       Validate permissions, Docker, config and harness readiness
  version                      Print configured image version

Routine commands are intentionally unprivileged. If Docker is not accessible to
your operator account, configure rootless Docker or appropriate Docker access
instead of prefixing Nidavelir commands with sudo.
EOF
}

case "${1:-}" in
  update) shift; cmd_update "$@" ;;
  status) shift; cmd_status "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  auth) shift; cmd_auth "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  version) shift; cmd_version "$@" ;;
  -h|--help|help|"") usage ;;
  *) fatal "unknown command '$1' (try: nidavelir help)" ;;
esac
