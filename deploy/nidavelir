#!/usr/bin/env bash
set -euo pipefail

NIDAVELIR_HOME="${NIDAVELIR_HOME:-/opt/nidavelir}"
COMPOSE_FILE="$NIDAVELIR_HOME/compose.yaml"
ENV_FILE="$NIDAVELIR_HOME/.env"
RAW_BASE="https://raw.githubusercontent.com/Nicolas25vlad/nidavelir/main"

fatal() {
  printf 'nidavelir: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fatal "$1 is required"
}

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

require_install() {
  [[ -r "$COMPOSE_FILE" ]] || fatal "installation not readable at $COMPOSE_FILE"
  [[ -r "$ENV_FILE" ]] || fatal "configuration not readable at $ENV_FILE"
}

require_write_access() {
  [[ -w "$COMPOSE_FILE" ]] || fatal "$COMPOSE_FILE is not writable; check membership in the nidavelir operator group"
  [[ -w "$ENV_FILE" ]] || fatal "$ENV_FILE is not writable; check membership in the nidavelir operator group"
}

require_docker_access() {
  need docker
  docker compose version >/dev/null 2>&1 || fatal "Docker Compose v2 is required"
  if ! docker info >/dev/null 2>&1; then
    fatal "cannot access the Docker daemon as $(id -un); use rootless Docker or grant this operator Docker access"
  fi
}

env_value() {
  local key="$1"
  awk -F= -v key="$key" '$1 == key {print substr($0, index($0, "=") + 1)}' "$ENV_FILE" | tail -n1
}

current_version() {
  env_value NIDAVELIR_VERSION
}

set_version() {
  local version="$1"
  if grep -q '^NIDAVELIR_VERSION=' "$ENV_FILE"; then
    local tmp
    tmp="$(mktemp)"
    awk -v version="$version" '
      BEGIN { updated = 0 }
      /^NIDAVELIR_VERSION=/ && !updated { print "NIDAVELIR_VERSION=" version; updated = 1; next }
      { print }
    ' "$ENV_FILE" > "$tmp"
    cat "$tmp" > "$ENV_FILE"
    rm -f "$tmp"
  else
    printf '\nNIDAVELIR_VERSION=%s\n' "$version" >> "$ENV_FILE"
  fi
}

installation_namespace() {
  local raw
  raw="$(env_value NIDAVELIR_INSTALLATION_ID)"
  [[ -n "$raw" ]] || raw="development"
  printf '%s' "$raw" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-24
}

worker_docker() {
  local socket
  socket="$(env_value NIDAVELIR_DOCKER_SOCKET)"
  [[ -n "$socket" ]] || socket="/var/run/docker.sock"
  docker --host "unix://$socket" "$@"
}

worker_image() {
  local version
  version="$(current_version)"
  [[ -n "$version" ]] || version="latest"
  printf 'ghcr.io/nicolas25vlad/nidavelir-worker:%s\n' "$version"
}

auth_volume() {
  local harness="$1"
  local configured namespace
  namespace="$(installation_namespace)"
  case "$harness" in
    codex)
      configured="$(env_value NIDAVELIR_CODEX_AUTH_VOLUME)"
      printf '%s\n' "${configured:-nidavelir-${namespace}-codex-auth}"
      ;;
    cursor)
      configured="$(env_value NIDAVELIR_CURSOR_AUTH_VOLUME)"
      printf '%s\n' "${configured:-nidavelir-${namespace}-cursor-auth}"
      ;;
    *) fatal "unsupported harness '$harness' (expected codex or cursor)" ;;
  esac
}

auth_mount() {
  case "$1" in
    codex) printf '%s\n' '/home/nidavelir/.codex' ;;
    cursor) printf '%s\n' '/home/nidavelir/.cursor' ;;
    *) fatal "unsupported harness '$1' (expected codex or cursor)" ;;
  esac
}

auth_volume_exists() {
  worker_docker volume inspect "$(auth_volume "$1")" >/dev/null 2>&1
}

ensure_auth_volume() {
  local harness="$1"
  local volume namespace
  volume="$(auth_volume "$harness")"
  namespace="$(installation_namespace)"
  if ! worker_docker volume inspect "$volume" >/dev/null 2>&1; then
    worker_docker volume create \
      --label io.nidavelir.auth=true \
      --label "io.nidavelir.installation=$namespace" \
      "$volume" >/dev/null
  fi
}

run_harness_auth() {
  local harness="$1"
  local interactive="$2"
  shift 2
  local volume mount image
  volume="$(auth_volume "$harness")"
  mount="$(auth_mount "$harness")"
  image="$(worker_image)"

  local tty_args=()
  if [[ "$interactive" == "interactive" ]]; then
    tty_args=(-it)
  fi

  worker_docker run --rm "${tty_args[@]}" \
    --user 10001:10001 \
    -e HOME=/home/nidavelir \
    -e CURSOR_CONFIG_DIR=/home/nidavelir/.cursor \
    -v "$volume:$mount" \
    "$image" "$@"
}

cmd_auth_login() {
  require_install
  require_docker_access
  local harness="${1:-}"
  [[ "$harness" == "codex" || "$harness" == "cursor" ]] \
    || fatal "usage: nidavelir auth login <codex|cursor>"

  local image
  image="$(worker_image)"
  printf 'Pulling worker image %s on the worker Docker daemon...\n' "$image"
  worker_docker pull "$image" >/dev/null
  ensure_auth_volume "$harness"

  case "$harness" in
    codex)
      run_harness_auth codex interactive codex login
      ;;
    cursor)
      worker_docker run --rm -it \
        --user 10001:10001 \
        -e HOME=/home/nidavelir \
        -e CURSOR_CONFIG_DIR=/home/nidavelir/.cursor \
        -e NO_OPEN_BROWSER=1 \
        -v "$(auth_volume cursor):$(auth_mount cursor)" \
        "$image" agent login
      ;;
  esac

  printf '\nPersistent %s login stored in Docker volume %s\n' \
    "$harness" "$(auth_volume "$harness")"
}

cmd_auth_status_one() {
  local harness="$1"
  if ! auth_volume_exists "$harness"; then
    printf '%s: no persistent login volume\n' "$harness"
    return 1
  fi
  case "$harness" in
    codex)
      if run_harness_auth codex noninteractive codex login status >/dev/null 2>&1; then
        printf 'codex: persistent login ready (%s)\n' "$(auth_volume codex)"
        return 0
      fi
      ;;
    cursor)
      if run_harness_auth cursor noninteractive agent status >/dev/null 2>&1; then
        printf 'cursor: persistent login ready (%s)\n' "$(auth_volume cursor)"
        return 0
      fi
      ;;
  esac
  printf '%s: auth volume exists but CLI reports no valid login\n' "$harness"
  return 1
}

cmd_auth_status() {
  require_install
  require_docker_access
  local harness="${1:-}"
  if [[ -n "$harness" ]]; then
    [[ "$harness" == "codex" || "$harness" == "cursor" ]] \
      || fatal "usage: nidavelir auth status [codex|cursor]"
    cmd_auth_status_one "$harness"
    return
  fi

  local failed=0
  cmd_auth_status_one codex || failed=1
  cmd_auth_status_one cursor || failed=1
  return "$failed"
}

cmd_auth_logout() {
  require_install
  require_docker_access
  local harness="${1:-}"
  [[ "$harness" == "codex" || "$harness" == "cursor" ]] \
    || fatal "usage: nidavelir auth logout <codex|cursor>"

  if auth_volume_exists "$harness"; then
    case "$harness" in
      codex) run_harness_auth codex noninteractive codex logout >/dev/null 2>&1 || true ;;
      cursor) run_harness_auth cursor noninteractive agent logout >/dev/null 2>&1 || true ;;
    esac
    worker_docker volume rm "$(auth_volume "$harness")" >/dev/null
  fi
  printf '%s persistent login removed\n' "$harness"
}

cmd_auth() {
  local action="${1:-status}"
  shift || true
  case "$action" in
    login) cmd_auth_login "$@" ;;
    status) cmd_auth_status "$@" ;;
    logout) cmd_auth_logout "$@" ;;
    *) fatal "usage: nidavelir auth <login|status|logout> [codex|cursor]" ;;
  esac
}

core_probe() {
  local path="$1"
  compose exec -T core python -c '
import sys
import urllib.error
import urllib.request

path = sys.argv[1]
try:
    with urllib.request.urlopen("http://127.0.0.1:8000" + path, timeout=5) as response:
        body = response.read().decode("utf-8")
        print(body)
        raise SystemExit(0 if 200 <= response.status < 300 else 1)
except urllib.error.HTTPError as error:
    print(error.read().decode("utf-8"), file=sys.stderr)
    raise SystemExit(1)
except Exception as error:
    print(f"probe failed: {error}", file=sys.stderr)
    raise SystemExit(1)
' "$path"
}

cmd_update() {
  require_install
  require_write_access
  require_docker_access
  need curl

  local requested="${1:-latest}"
  local previous
  previous="$(current_version)"
  [[ -n "$previous" ]] || previous="latest"

  printf 'Updating Nidavelir: %s -> %s\n' "$previous" "$requested"

  local tmp
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN
  curl -fsSL "$RAW_BASE/deploy/compose.prod.yaml" -o "$tmp"
  docker compose --env-file "$ENV_FILE" -f "$tmp" config --quiet
  cat "$tmp" > "$COMPOSE_FILE"
  set_version "$requested"

  if ! compose pull; then
    set_version "$previous"
    fatal "image pull failed; version restored to $previous"
  fi

  if ! compose up -d --remove-orphans; then
    printf 'Update failed, attempting rollback to %s\n' "$previous" >&2
    set_version "$previous"
    compose pull || true
    compose up -d --remove-orphans || true
    fatal "update failed and rollback was attempted"
  fi

  compose ps
  printf 'Nidavelir is running version %s\n' "$requested"
}

cmd_status() {
  require_install
  require_docker_access
  compose ps
}

cmd_health() {
  require_install
  require_docker_access
  core_probe /health
}

cmd_ready() {
  require_install
  require_docker_access
  core_probe /ready
}

cmd_logs() {
  require_install
  require_docker_access
  local service="${1:-}"
  if [[ -n "$service" ]]; then
    compose logs --tail=200 -f "$service"
  else
    compose logs --tail=200 -f
  fi
}

cmd_restart() {
  require_install
  require_docker_access
  compose restart "$@"
  compose ps
}

cmd_stop() {
  require_install
  require_docker_access
  compose stop
}

cmd_start() {
  require_install
  require_docker_access
  compose up -d
  compose ps
}

cmd_mcp_token() {
  require_install
  local token
  token="$(env_value NIDAVELIR_MCP_AUTH_TOKEN)"
  [[ -n "$token" ]] || fatal "NIDAVELIR_MCP_AUTH_TOKEN is not configured"
  printf '%s\n' "$token"
}

cmd_operator_token() {
  require_install
  local token
  token="$(env_value NIDAVELIR_OPERATOR_TOKEN)"
  [[ -n "$token" ]] || fatal "NIDAVELIR_OPERATOR_TOKEN is not configured"
  printf '%s\n' "$token"
}

cmd_doctor() {
  require_install

  local failed=0
  local codex_ready=0
  local cursor_ready=0
  local docker_ready=0
  printf 'Install dir: %s\n' "$NIDAVELIR_HOME"
  printf 'Version: %s\n' "$(current_version)"
  printf 'Operator: %s\n' "$(id -un)"

  if [[ -w "$ENV_FILE" && -w "$COMPOSE_FILE" ]]; then
    printf 'Permissions: operator files writable\n'
  else
    printf 'FAILED: operator cannot write Nidavelir config/update files\n'
    failed=1
  fi

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
      printf 'Docker: accessible without sudo\n'
      docker_ready=1
    else
      printf 'FAILED: Docker daemon is not accessible as %s\n' "$(id -un)"
      failed=1
    fi
  else
    printf 'FAILED: Docker Engine and Compose v2 are required\n'
    failed=1
  fi

  for key in NIDAVELIR_DATABASE_URL NIDAVELIR_POSTGRES_PASSWORD; do
    if ! grep -q "^${key}=." "$ENV_FILE"; then
      printf 'MISSING: %s\n' "$key"
      failed=1
    fi
  done

  if ! grep -q '^NIDAVELIR_GITHUB_TOKEN=.' "$ENV_FILE"; then
    printf 'MISSING: NIDAVELIR_GITHUB_TOKEN (task branches cannot be pushed)\n'
    failed=1
  fi

  if grep -q '^NIDAVELIR_OPENAI_API_KEY=.' "$ENV_FILE"; then
    codex_ready=1
    printf 'Harness: Codex API-key auth configured\n'
  elif auth_volume_exists codex; then
    codex_ready=1
    printf 'Harness: Codex persistent login volume present\n'
  else
    printf 'Harness: Codex auth not configured\n'
  fi

  if grep -q '^NIDAVELIR_CURSOR_API_KEY=.' "$ENV_FILE"; then
    cursor_ready=1
    printf 'Harness: Cursor API-key auth configured\n'
  elif auth_volume_exists cursor; then
    cursor_ready=1
    printf 'Harness: Cursor persistent login volume present\n'
  else
    printf 'Harness: Cursor auth not configured\n'
  fi

  if [[ "$codex_ready" -eq 0 && "$cursor_ready" -eq 0 ]]; then
    printf 'WARN: no coding harness authentication is configured\n'
  fi

  local operator_token service_token mcp_token mcp_bind mcp_resource
  operator_token="$(env_value NIDAVELIR_OPERATOR_TOKEN)"
  service_token="$(env_value NIDAVELIR_SERVICE_TOKEN)"
  mcp_token="$(env_value NIDAVELIR_MCP_AUTH_TOKEN)"
  mcp_bind="$(env_value NIDAVELIR_MCP_BIND_ADDRESS)"
  mcp_resource="$(env_value NIDAVELIR_MCP_RESOURCE_URL)"

  if [[ ${#operator_token} -lt 32 ]]; then
    printf 'FAILED: Web/Core operator token is missing or too short\n'
    failed=1
  else
    printf 'Web/Core auth: operator token configured\n'
  fi
  if [[ ${#service_token} -lt 32 ]]; then
    printf 'FAILED: internal Core service token is missing or too short\n'
    failed=1
  else
    printf 'Core service auth: internal token configured\n'
  fi
  if [[ ${#mcp_token} -lt 32 ]]; then
    printf 'FAILED: MCP bearer token is missing or too short\n'
    failed=1
  else
    printf 'MCP auth: bearer token configured\n'
  fi
  if [[ -n "$mcp_bind" && "$mcp_bind" != "127.0.0.1" && "$mcp_bind" != "::1" ]]; then
    if [[ "$mcp_resource" != https://* ]]; then
      printf 'WARN: MCP is externally bound but its public resource URL is not HTTPS\n'
    fi
  fi

  if ! compose config --quiet; then
    printf 'FAILED: compose config\n'
    failed=1
  fi

  if [[ "$docker_ready" -eq 1 ]] && compose ps >/dev/null 2>&1; then
    compose ps
    if core_probe /ready >/tmp/nidavelir-ready.$$ 2>&1; then
      printf 'Readiness: Core dependencies ready\n'
      rm -f /tmp/nidavelir-ready.$$
    else
      printf 'FAILED: Core readiness probe did not pass\n'
      cat /tmp/nidavelir-ready.$$ >&2 || true
      rm -f /tmp/nidavelir-ready.$$
      failed=1
    fi
  else
    printf 'WARN: stack status/readiness unavailable\n'
  fi

  if [[ "$failed" -eq 0 ]]; then
    printf 'Doctor: OK\n'
  else
    printf 'Doctor: configuration needs attention\n'
    exit 1
  fi
}

cmd_version() {
  require_install
  current_version
}

usage() {
  cat <<'EOF'
Usage: nidavelir <command> [args]

Commands:
  update [version]   Pull and deploy latest or a pinned tag/SHA image tag
  status             Show service state
  health             Query the Core liveness endpoint inside the private network
  ready              Verify Postgres, Docker and worker-image readiness
  logs [service]     Follow logs, optionally for one service
  restart [service]  Restart the whole stack or selected service(s)
  start              Start the stack
  stop               Stop services without deleting data
  auth login <h>     Log Codex/Cursor in once and persist only that harness session
  auth status [h]    Check persistent Codex/Cursor login state
  auth logout <h>    Remove one persistent harness login and its Docker volume
  doctor             Validate permissions, Docker, config, auth and live readiness
  operator-token     Print the Web/Core operator token for browser login
  mcp-token          Print the MCP bearer token for explicit client configuration
  version            Print configured image version

Routine commands are intentionally unprivileged. If Docker is not accessible to
your operator account, configure rootless Docker or appropriate Docker access
instead of prefixing Nidavelir commands with sudo.
EOF
}

case "${1:-}" in
  update) shift; cmd_update "$@" ;;
  status) shift; cmd_status "$@" ;;
  health) shift; cmd_health "$@" ;;
  ready) shift; cmd_ready "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  start) shift; cmd_start "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  auth) shift; cmd_auth "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  operator-token) shift; cmd_operator_token "$@" ;;
  mcp-token) shift; cmd_mcp_token "$@" ;;
  version) shift; cmd_version "$@" ;;
  -h|--help|help|"") usage ;;
  *) fatal "unknown command '$1' (try: nidavelir help)" ;;
esac
