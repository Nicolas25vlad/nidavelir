# Database
NIDAVELIR_DATABASE_URL=postgresql+psycopg://nidavelir:nidavelir@localhost:5432/nidavelir

# Runtime
NIDAVELIR_ENV=development
NIDAVELIR_INSTALLATION_ID=development
NIDAVELIR_COMPOSE_PROJECT_NAME=nidavelir
NIDAVELIR_LOG_LEVEL=INFO
NIDAVELIR_MAX_PARALLEL_WORKERS=2

# Docker host integration. Point this at a dedicated/rootless Docker socket for stronger isolation.
NIDAVELIR_DOCKER_SOCKET=/var/run/docker.sock

# Local host bindings. Change ports when the shared server already uses them.
NIDAVELIR_CORE_BIND_ADDRESS=127.0.0.1
NIDAVELIR_CORE_HOST_PORT=8000
NIDAVELIR_MCP_BIND_ADDRESS=127.0.0.1
NIDAVELIR_MCP_HOST_PORT=8001
NIDAVELIR_WEB_BIND_ADDRESS=127.0.0.1
NIDAVELIR_WEB_HOST_PORT=8080

# Worker runtime
NIDAVELIR_WORKER_IMAGE=nidavelir-worker:dev
NIDAVELIR_WORKER_CPUS=1.0
NIDAVELIR_WORKER_MEMORY=2g
NIDAVELIR_WORKER_TIMEOUT_SECONDS=1800
NIDAVELIR_WORKER_STOP_TIMEOUT_SECONDS=10

# Long-running service budgets for shared Docker hosts
NIDAVELIR_POSTGRES_CPUS=0.50
NIDAVELIR_POSTGRES_MEMORY=512m
NIDAVELIR_CORE_CPUS=0.75
NIDAVELIR_CORE_MEMORY=512m
NIDAVELIR_CORE_PIDS_LIMIT=256
NIDAVELIR_MCP_CPUS=0.25
NIDAVELIR_MCP_MEMORY=256m
NIDAVELIR_MCP_PIDS_LIMIT=128
NIDAVELIR_WEB_CPUS=0.25
NIDAVELIR_WEB_MEMORY=128m
NIDAVELIR_WEB_PIDS_LIMIT=64

# Runtime credentials. Keep real values only in .env / secret storage.
NIDAVELIR_GITHUB_TOKEN=
NIDAVELIR_OPENAI_API_KEY=
NIDAVELIR_CURSOR_API_KEY=

# External MCP authentication. Production install generates a random token.
NIDAVELIR_MCP_AUTH_TOKEN=
NIDAVELIR_MCP_RESOURCE_URL=http://127.0.0.1:8001/mcp
NIDAVELIR_MCP_ISSUER_URL=http://127.0.0.1:8001
